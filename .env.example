# Use an authorized custom source service:
SOURCE_API_URL=https://your-source-server.example/api/sources
SOURCE_API_TOKEN=optional-bearer-token

# Or use the verified vidsrc.pm player API contract:
SOURCE_PROVIDER=vidsrc.pm
VIDSRCPM_API_URL=https://vidsrc.pm/api/vidora
VIDSRCPM_PLAYER_KEY=provider-issued-player-key
VIDSRCPM_SOURCE_KEYS=k2mq,p9fx,b4tz,w7dn,r3yk

# Space-separated media origins allowed by Content-Security-Policy.
SOURCE_MEDIA_ORIGINS=https://your-media-host.example

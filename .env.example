# Server-side endpoint for an authorized/licensed source service.
# It receives type, id, and for TV content season + episode as query parameters.
SOURCE_API_URL=https://your-source-server.example/api/sources
# Optional bearer token sent only from the Next.js server.
SOURCE_API_TOKEN=
# Space-separated media origins allowed by the Content-Security-Policy.
SOURCE_MEDIA_ORIGINS=https://your-media-host.example
